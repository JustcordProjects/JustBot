{
    "compilerOptions": {
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": [
            "es2024",
            "deno.ns", "deno.window",
            "dom"
        ]
    },
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "lineWidth": 500,
        "semiColons": true,
        "singleQuote": true
    },
    "lint": {
        "rules": {
            "exclude": [
                "no-namespace",
                "no-empty",
                "require-await"
            ]
        }
    },
    "imports": {
        "@std/path": "jsr:@std/path@^1.1.6",
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@vitalets/google-translate-api": "npm:@vitalets/google-translate-api@^9.2.1",
        "discord.js": "npm:discord.js@^14.27.0",
        "figlet": "npm:figlet@^1.11.0",
        "imapflow": "npm:imapflow@^1.3.2",
        "json5": "npm:json5@^2.2.3",
        "mailparser": "npm:mailparser@^3.9.14",
        "nodemailer": "npm:nodemailer@^9.0.3",
        "gemini": "npm:@google/generative-ai@^0.24.1",
        "pokenode-ts": "npm:pokenode-ts@^1.20.0",
        "sqlite": "https://deno.land/x/sqlite@v3.9.1/mod.ts",
        "@/": "./src/",
        "#tests/": "./tests/"
    }
}
